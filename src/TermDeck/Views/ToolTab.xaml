<UserControl x:Class="TermDeck.Views.ToolTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:term="clr-namespace:TermDeck.Terminal">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="300" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition x:Name="HistoryColumn" Width="300" MinWidth="180" />
        </Grid.ColumnDefinitions>

        <!-- Terminal + command bar -->
        <DockPanel Grid.Column="0">
            <Border DockPanel.Dock="Top" Background="#1F1F1F" Padding="10,5">
                <DockPanel>
                    <TextBlock x:Name="RunStatus" DockPanel.Dock="Right" Foreground="#9A9A9A" FontSize="12" Margin="12,0,0,0" />
                    <TextBlock x:Name="RunInfo" Foreground="#D4D4D4" FontFamily="{StaticResource MonoFont}" FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Background="{DynamicResource CommandBarBg}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,1,0,0" Padding="8,6">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,5">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8B7;" Foreground="#C8930C" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8DA;" ToolTip="Choose working directory" Click="PickCwd_Click" Height="20" />
                        <TextBlock x:Name="CwdText" Foreground="{DynamicResource TextSecondary}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="Working directory" />
                    </DockPanel>
                    <Button x:Name="StopButton" DockPanel.Dock="Right" Margin="4,0,0,0" Padding="10,4" Click="Stop_Click" IsEnabled="False"
                            ToolTip="Stop (Ctrl+C, kill after 1.5s)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE71A;" Foreground="#C50F1F" VerticalAlignment="Center" />
                            <TextBlock Text=" Stop" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RunButton" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="12,4" Click="Run_Click" IsDefault="False"
                            ToolTip="Run (Enter)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE768;" Foreground="#13A10E" VerticalAlignment="Center" />
                            <TextBlock Text=" Run" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Border x:Name="Badge" DockPanel.Dock="Left" CornerRadius="3" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                        <TextBlock x:Name="BadgeText" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <TextBlock x:Name="ToolPathText" DockPanel.Dock="Left" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,6,0" MaxWidth="320" TextTrimming="CharacterEllipsis" />
                    <Button x:Name="RunAsButton" DockPanel.Dock="Left" Margin="0,0,6,0" Padding="8,4"
                            Click="RunAs_Click" ToolTip="Choose the account this run uses">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE77B;" FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock x:Name="RunAsLabel" VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <TextBox x:Name="ArgsBox" FontFamily="{StaticResource MonoFont}" FontSize="13" Padding="4,3" VerticalContentAlignment="Center"
                             AllowDrop="True" PreviewKeyDown="ArgsBox_PreviewKeyDown"
                             PreviewDragOver="ArgsBox_PreviewDragOver" PreviewDrop="ArgsBox_PreviewDrop"
                             ToolTip="Arguments — Enter to run, ↑/↓ to browse history, drop files from the Files panel to insert their paths" />
                </DockPanel>
            </Border>

            <term:TerminalHost x:Name="Term" />
        </DockPanel>

        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{DynamicResource ChromeBg}" DragCompleted="Splitter_DragCompleted" />

        <!-- History -->
        <DockPanel Grid.Column="2" Background="{DynamicResource PanelBg}">
            <Border DockPanel.Dock="Top" Background="{DynamicResource ChromeBg}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,0,0,1" Padding="8,4">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Reload" Click="Reload_Click" />
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE81C;" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock x:Name="HistoryHeader" Style="{StaticResource PanelHeader}" Text="History" />
                </DockPanel>
            </Border>
            <Border DockPanel.Dock="Top" Padding="6,5" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBox x:Name="SearchBox" Padding="22,2,2,2" TextChanged="SearchBox_TextChanged" />
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" Foreground="{DynamicResource TextMuted}" Margin="6,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
            </Border>
            <ListBox x:Name="RunsList" BorderThickness="0" SelectionChanged="RunsList_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="RunsList_MouseDoubleClick">
                <ListBox.ContextMenu>
                    <ContextMenu Opened="RunsMenu_Opened">
                        <MenuItem Header="Run again" Click="Rerun_Click">
                            <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE768;" Foreground="#13A10E" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Use these arguments" Click="UseArgs_Click" />
                        <MenuItem Header="Copy command" Click="CopyCommand_Click">
                            <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8C8;" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Copy output as text" Click="CopyOutput_Click" />
                        <MenuItem Header="Export output..." Click="SaveOutput_Click" ToolTip="Save as plain text, ANSI (colors) or HTML">
                            <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74E;" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Show log file (.cast)" Click="OpenLog_Click" />
                        <MenuItem x:Name="AutorunMenu" Header="Autorun">
                            <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE945;" Foreground="#C8930C" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Delete from history" Click="DeleteRun_Click">
                            <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74D;" Foreground="#C50F1F" /></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="6,4" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel ToolTip="{Binding Record.CommandLine}">
                            <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="{Binding StatusGlyph}"
                                       Foreground="{Binding StatusBrush}" FontSize="13" Margin="0,2,8,0" VerticalAlignment="Top" />
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Meta}" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,1,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</UserControl>
