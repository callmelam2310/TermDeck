<Window x:Class="TermDeck.Views.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:term="clr-namespace:TermDeck.Terminal"
        Title="Search history" Width="1180" Height="740" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource ChromeBg}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="10,8" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,0,0,1">
            <DockPanel>
                <ComboBox x:Name="ToolFilter" DockPanel.Dock="Right" Width="240" Margin="8,0,0,0" DisplayMemberPath="Label"
                          SelectionChanged="ToolFilter_SelectionChanged" ToolTip="Limit the search to one tool" />
                <Grid>
                    <TextBox x:Name="QueryBox" Padding="26,4,4,4" FontSize="14" FontFamily="{StaticResource MonoFont}"
                             TextChanged="QueryBox_TextChanged" PreviewKeyDown="QueryBox_PreviewKeyDown"
                             ToolTip="Text to find in the output, arguments and command of every run (case-insensitive substring)" />
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" Foreground="{DynamicResource TextMuted}"
                               Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="10,7" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="OpenButton" Padding="12,4" Margin="0,0,6,0" Click="Open_Click" IsEnabled="False"
                            ToolTip="Open the tool's tab and show this run (double-click)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8A7;" Foreground="#1E73D8" VerticalAlignment="Center" />
                            <TextBlock Text=" Open in tab" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ReportButton" Padding="12,4" Margin="0,0,6,0" Click="Report_Click" IsEnabled="False"
                            ToolTip="Export the matching runs as an HTML or Markdown report">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE9F9;" Foreground="#13A10E" VerticalAlignment="Center" />
                            <TextBlock Text=" Report of these results..." />
                        </StackPanel>
                    </Button>
                    <Button Content="Close" Padding="14,4" IsCancel="True" Click="Close_Click" />
                </StackPanel>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440" MinWidth="260" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="Results" Grid.Column="0" BorderThickness="0" Background="{DynamicResource PanelBg}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                     SelectionChanged="Results_SelectionChanged" MouseDoubleClick="Results_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="8,5" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel ToolTip="{Binding Run.Record.CommandLine}">
                            <TextBlock DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" Text="{Binding Run.StatusGlyph}"
                                       Foreground="{Binding Run.StatusBrush}" FontSize="13" Margin="0,2,8,0" VerticalAlignment="Top" />
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Foreground="{DynamicResource Accent}" FontSize="11" Margin="6,1,0,0" />
                                    <TextBlock Text="{Binding Run.Record.ToolName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <TextBlock Text="{Binding Run.Title}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Run.Meta}" Foreground="{DynamicResource TextMuted}" FontSize="11" />
                                <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                                           Foreground="{DynamicResource TextSecondary}">
                                    <Run Text="{Binding Before, Mode=OneWay}" /><Run Text="{Binding Match, Mode=OneWay}" Background="#66F9D849" FontWeight="SemiBold" /><Run Text="{Binding After, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{DynamicResource ChromeBg}" />

            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Top" Background="#1F1F1F" Padding="10,5">
                    <TextBlock x:Name="PreviewInfo" Foreground="#D4D4D4" FontFamily="{StaticResource MonoFont}" FontSize="12"
                               TextTrimming="CharacterEllipsis" Text="Select a result to preview its output." />
                </Border>
                <term:TerminalHost x:Name="Preview" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
