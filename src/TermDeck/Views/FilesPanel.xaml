<UserControl x:Class="TermDeck.Views.FilesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Background="{DynamicResource PanelBg}">
        <Border DockPanel.Dock="Top" Background="{DynamicResource ChromeBg}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,0,0,1" Padding="3">
            <WrapPanel>
                <Button Style="{StaticResource IconButton}" Content="&#xE74A;" ToolTip="Parent folder" Click="Up_Click" Foreground="#1E73D8" />
                <Button Style="{StaticResource IconButton}" Content="&#xE80F;" ToolTip="Project folder" Click="Home_Click" Foreground="#1E73D8" />
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh (F5)" Click="Refresh_Click" Foreground="#13A10E" />
                <Rectangle Width="1" Fill="{DynamicResource ChromeBorder}" Margin="3,4" />
                <Button Style="{StaticResource IconButton}" Content="&#xE8F4;" ToolTip="New folder" Click="NewFolder_Click" Foreground="#C8930C" />
                <Button Style="{StaticResource IconButton}" Content="&#xE8A5;" ToolTip="New file" Click="NewFile_Click" Foreground="{DynamicResource TextSecondary}" />
                <Button Style="{StaticResource IconButton}" Content="&#xE8AC;" ToolTip="Rename (F2)" Click="Rename_Click" Foreground="{DynamicResource TextSecondary}" />
                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete (Del)" Click="Delete_Click" Foreground="#C50F1F" />
                <Rectangle Width="1" Fill="{DynamicResource ChromeBorder}" Margin="3,4" />
                <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" ToolTip="Open in Windows Explorer" Click="OpenExplorer_Click" Foreground="{DynamicResource TextSecondary}" />
                <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="Copy path (in the tool's format)" Click="CopyPath_Click" Foreground="{DynamicResource TextSecondary}" />
            </WrapPanel>
        </Border>
        <Border DockPanel.Dock="Top" Padding="4" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,0,0,1">
            <TextBox x:Name="PathBox" FontFamily="{StaticResource MonoFont}" FontSize="12" Padding="2" KeyDown="PathBox_KeyDown"
                     ToolTip="Type a path (Windows or Linux) and press Enter" />
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ChromeBg}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,1,0,0" Padding="6,4">
            <DockPanel>
                <TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="{DynamicResource TextMuted}" FontSize="11" VerticalAlignment="Center" />
                <CheckBox x:Name="FollowBox" Content="Follow terminal folder" VerticalAlignment="Center"
                          Checked="FollowBox_Changed" Unchecked="FollowBox_Changed"
                          ToolTip="On: this panel follows the active tab's working directory, and browsing here changes where the tab runs" />
            </DockPanel>
        </Border>
        <ListView x:Name="FileList" BorderThickness="0" SelectionMode="Extended" AllowDrop="True"
                  MouseDoubleClick="List_MouseDoubleClick" KeyDown="List_KeyDown"
                  PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown" PreviewMouseMove="List_PreviewMouseMove"
                  DragOver="List_DragOver" Drop="List_Drop" SizeChanged="FileList_SizeChanged"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open" Click="Open_Click" FontWeight="SemiBold" />
                    <MenuItem Header="Insert path into command" Click="Insert_Click">
                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE76C;" Foreground="#13A10E" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Copy path" Click="CopyPath_Click">
                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8C8;" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Copy Windows path" Click="CopyWinPath_Click" />
                    <Separator />
                    <MenuItem Header="Rename" InputGestureText="F2" Click="Rename_Click" />
                    <MenuItem Header="Delete" InputGestureText="Del" Click="Delete_Click">
                        <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74D;" Foreground="#C50F1F" /></MenuItem.Icon>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="New folder" Click="NewFolder_Click" />
                    <MenuItem Header="New file" Click="NewFile_Click" />
                    <MenuItem Header="Open in Windows Explorer" Click="OpenExplorer_Click" />
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
                <GridView>
                    <GridViewColumn x:Name="NameColumn" Header="Name" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}" Margin="0,1,6,0" />
                                    <TextBlock Text="{Binding Name}" Opacity="{Binding TextOpacity}" />
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="SizeColumn" Header="Size" Width="58">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="ModifiedColumn" Header="Modified" Width="78" DisplayMemberBinding="{Binding ModifiedText}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
