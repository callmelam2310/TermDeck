<Window x:Class="TermDeck.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TermDeck.Views"
        Title="TermDeck" Icon="/Assets/TermDeck.ico" Width="1400" Height="860" MinWidth="900" MinHeight="500"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource ChromeBg}"
        Closing="Window_Closing">
    <Window.Resources>
        <!-- Tool row with a WIN/WSL badge -->
        <DataTemplate x:Key="ToolRow">
            <DockPanel Margin="0,1" ToolTip="{Binding Path}">
                <Border DockPanel.Dock="Left" Width="30" CornerRadius="3" Padding="0,1" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource WinBadge}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Wsl">
                                    <Setter Property="Background" Value="{DynamicResource WslBadge}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Foreground="White" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="WIN" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="Wsl">
                                        <Setter Property="Text" Value="WSL" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding KindLabel}" Foreground="{DynamicResource TextMuted}" FontSize="11" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <!-- Collection header: folder icon, name, tool count -->
        <DataTemplate x:Key="CollectionHeader">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,1,6,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="&#xE8B7;" />
                            <Setter Property="Foreground" Value="#C8930C" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUngrouped}" Value="True">
                                    <Setter Property="Text" Value="&#xE8FD;" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Background="{DynamicResource PillBg}" CornerRadius="7" Padding="6,0" Margin="6,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CountText}" FontSize="10" Foreground="{DynamicResource TextMuted}" />
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Menu -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource ChromeBg}" Padding="2">
            <MenuItem Header="_File">
                <MenuItem Header="Open project..." InputGestureText="Ctrl+O" Click="OpenProject_Click" />
                <MenuItem x:Name="RecentMenu" Header="Recent projects" />
                <Separator />
                <MenuItem Header="Open data folder" Click="OpenDataDir_Click" />
                <MenuItem Header="Open project history folder" Click="OpenHistoryDir_Click" />
                <Separator />
                <MenuItem Header="Exit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="New tool..." InputGestureText="Ctrl+N" Click="NewTool_Click" />
                <MenuItem Header="New collection..." InputGestureText="Ctrl+Shift+N" Click="NewCollection_Click" />
                <Separator />
                <MenuItem Header="Edit..." InputGestureText="F2" Click="Edit_Click" />
                <MenuItem Header="Duplicate tool" Click="DuplicateTool_Click" />
                <MenuItem Header="Delete" Click="Delete_Click" />
                <Separator />
                <MenuItem Header="Find in terminal" InputGestureText="Ctrl+F" Click="Find_Click" />
                <MenuItem Header="Close tab" InputGestureText="Ctrl+W" Click="CloseCurrentTab_Click" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Sidebar" InputGestureText="Ctrl+B" Click="ToggleSidebar_Click" />
                <MenuItem Header="Tools" Click="ShowTools_Click" />
                <MenuItem Header="Files" Click="ShowFiles_Click" />
            </MenuItem>
            <MenuItem Header="_Settings">
                <MenuItem Header="Settings..." Click="Settings_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="About TermDeck" Click="About_Click" />
            </MenuItem>
        </Menu>

        <!-- Large icon toolbar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource ToolbarBg}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,1,0,1" Padding="4,2">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource RibbonButton}" Click="Exit_Click" ToolTip="Exit TermDeck">
                    <StackPanel>
                        <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE7E8;" Foreground="#C50F1F" />
                        <TextBlock Style="{StaticResource RibbonLabel}" Text="Exit" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource RibbonButton}" Click="NewTool_Click" ToolTip="Add a new tool (Ctrl+N)">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE710;" Foreground="#13A10E" />
                            <TextBlock Style="{StaticResource RibbonLabel}" Text="New tool" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource RibbonButton}" Click="NewCollection_Click" ToolTip="Create a named collection of tools (Ctrl+Shift+N)">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE8F4;" Foreground="#C8930C" />
                            <TextBlock Style="{StaticResource RibbonLabel}" Text="Collection" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource RibbonButton}" Click="OpenProject_Click" ToolTip="Open a project folder (Ctrl+O)">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE838;" Foreground="#2B6CB0" />
                            <TextBlock Style="{StaticResource RibbonLabel}" Text="Project" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource RibbonButton}" Click="Edit_Click" ToolTip="Edit the selected tool or collection (F2)">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE70F;" Foreground="#1E73D8" />
                            <TextBlock Style="{StaticResource RibbonLabel}" Text="Edit" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Fill="{DynamicResource ChromeBorder}" Margin="6,8" />
                    <Button Style="{StaticResource RibbonButton}" Click="ShowTools_Click" ToolTip="Tool list">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE756;" Foreground="#0F6CBD" />
                            <TextBlock Style="{StaticResource RibbonLabel}" Text="Tools" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource RibbonButton}" Click="ShowFiles_Click" ToolTip="File browser">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE8B7;" Foreground="#C8930C" />
                            <TextBlock Style="{StaticResource RibbonLabel}" Text="Files" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource RibbonButton}" Click="ToggleSidebar_Click" ToolTip="Show/hide sidebar (Ctrl+B)">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE89F;" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Style="{StaticResource RibbonLabel}" Text="Sidebar" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Fill="{DynamicResource ChromeBorder}" Margin="6,8" />
                    <Button Style="{StaticResource RibbonButton}" Click="Settings_Click" ToolTip="Settings">
                        <StackPanel>
                            <TextBlock Style="{StaticResource RibbonIcon}" Text="&#xE713;" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Style="{StaticResource RibbonLabel}" Text="Settings" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource ChromeBg}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,1,0,0">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="False" />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8B7;" Foreground="#C8930C" Margin="0,1,5,0" />
                    <TextBlock x:Name="StatusProject" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <TextBlock x:Name="StatusMode" Foreground="{DynamicResource TextMuted}" />
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right" Margin="0,0,16,0">
                <TextBlock x:Name="StatusRunning" Foreground="#1E73D8" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="SidebarColumn" Width="270" />
                <ColumnDefinition x:Name="SplitterColumn" Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Vertical sidebar tabs -->
            <Border Grid.Column="0" Background="{DynamicResource SideStripBg}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,0,1,0">
                <StackPanel>
                    <RadioButton x:Name="ToolsSideTab" GroupName="side" Style="{StaticResource SideTab}" Click="SideTab_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE756;" Foreground="#0F6CBD" Margin="0,1,5,0">
                                <TextBlock.LayoutTransform><RotateTransform Angle="90" /></TextBlock.LayoutTransform>
                            </TextBlock>
                            <TextBlock Text="Tools" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="FilesSideTab" GroupName="side" Style="{StaticResource SideTab}" Click="SideTab_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8B7;" Foreground="#C8930C" Margin="0,1,5,0">
                                <TextBlock.LayoutTransform><RotateTransform Angle="90" /></TextBlock.LayoutTransform>
                            </TextBlock>
                            <TextBlock Text="Files" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- Sidebar -->
            <Grid Grid.Column="1">
                <DockPanel x:Name="ToolsPanel" Background="{DynamicResource PanelBg}">
                    <Border DockPanel.Dock="Top" Background="{DynamicResource ChromeBg}" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,0,0,1" Padding="8,3,3,3">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource IconButton}" Content="&#xE710;" Foreground="#13A10E" ToolTip="New tool" Click="NewTool_Click" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE8F4;" Foreground="#C8930C" ToolTip="New collection" Click="NewCollection_Click" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE70F;" Foreground="#1E73D8" ToolTip="Edit (F2)" Click="Edit_Click" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" Foreground="{DynamicResource TextSecondary}" ToolTip="Duplicate tool" Click="DuplicateTool_Click" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Foreground="#C50F1F" ToolTip="Delete (Del)" Click="Delete_Click" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource PanelHeader}" Text="Tools" />
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Top" Padding="6,5" BorderBrush="{DynamicResource ChromeBorder}" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBox x:Name="ToolSearch" Padding="22,2,2,2" TextChanged="ToolSearch_TextChanged" ToolTip="Filter tools by name or path" />
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" Foreground="{DynamicResource TextMuted}" Margin="6,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <TreeView x:Name="ToolsTree" BorderThickness="0" AllowDrop="True" Padding="0,4"
                              MouseDoubleClick="ToolsTree_MouseDoubleClick" KeyDown="ToolsTree_KeyDown"
                              PreviewMouseRightButtonDown="ToolsTree_PreviewMouseRightButtonDown"
                              PreviewMouseLeftButtonDown="ToolsTree_PreviewMouseLeftButtonDown" PreviewMouseMove="ToolsTree_PreviewMouseMove"
                              DragOver="ToolsTree_DragOver" Drop="ToolsTree_Drop" ContextMenuOpening="ToolsTree_ContextMenuOpening">
                        <TreeView.ContextMenu>
                            <ContextMenu />
                        </TreeView.ContextMenu>
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type local:CollectionNode}" ItemsSource="{Binding Tools}" ItemTemplate="{StaticResource ToolRow}">
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CollectionHeader}" Margin="0,4" />
                                <HierarchicalDataTemplate.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                        <Setter Property="Padding" Value="2,3" />
                                    </Style>
                                </HierarchicalDataTemplate.ItemContainerStyle>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </DockPanel>
                <local:FilesPanel x:Name="Files" Visibility="Collapsed" />
            </Grid>

            <GridSplitter Grid.Column="2" HorizontalAlignment="Stretch" Background="{DynamicResource ChromeBg}" />

            <!-- Tab area -->
            <DockPanel Grid.Column="3">
                <Border DockPanel.Dock="Top" Background="{DynamicResource ChromeBg}" BorderBrush="{DynamicResource Accent}" BorderThickness="0,0,0,2" Padding="4,4,4,0">
                    <ListBox x:Name="TabStrip" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource DocTabItem}"
                             SelectionChanged="TabStrip_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="TabStrip_PreviewMouseWheel">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" MouseDown="TabHeader_MouseDown">
                                    <TextBlock FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,1,6,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE756;" />
                                                <Setter Property="Foreground" Value="{DynamicResource WinBadge}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWsl}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource WslBadge}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsHome}" Value="True">
                                                        <Setter Property="Text" Value="&#xE80F;" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                                    <Ellipse Width="7" Height="7" Fill="#13A10E" Margin="6,1,0,0" VerticalAlignment="Center" ToolTip="Running">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <Button Content="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="9" Padding="3" Margin="8,0,0,0"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Close tab (middle-click)"
                                            Click="CloseTab_Click" Tag="{Binding}" VerticalAlignment="Center">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHome}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Grid x:Name="ContentHost" Background="{DynamicResource PanelBg}">
                    <!-- Home -->
                    <ScrollViewer x:Name="HomeView" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="40,30" MaxWidth="980" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/Assets/logo.png" Width="52" Height="52" Margin="0,0,12,0"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="TermDeck" FontSize="26" FontWeight="SemiBold" />
                                    <TextBlock Text="Project-based terminal — one tab per tool, every run is kept." Foreground="{DynamicResource TextMuted}" />
                                </StackPanel>
                            </StackPanel>

                            <Border Background="{DynamicResource ChromeBg}" CornerRadius="4" Padding="12,8" Margin="0,20,0,0">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Change project..." Padding="10,3" Click="OpenProject_Click" />
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8B7;" Foreground="#C8930C" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock x:Name="HomeProject" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Border>

                            <DockPanel Margin="0,24,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Padding="10,3" Margin="0,0,6,0" Click="NewCollection_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8F4;" Foreground="#C8930C" VerticalAlignment="Center" />
                                            <TextBlock Text=" New collection" />
                                        </StackPanel>
                                    </Button>
                                    <Button Padding="10,3" Click="NewTool_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" Foreground="#13A10E" VerticalAlignment="Center" />
                                            <TextBlock Text=" New tool" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="Tools" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock x:Name="HomeNoTools" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Visibility="Collapsed"
                                       Text="No tools yet. Click “New tool” to add a Windows executable (e.g. nmap.exe) or a WSL command (e.g. nuclei)." />
                            <ItemsControl x:Name="HomeGroups">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4,0,6">
                                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CollectionHeader}" Margin="0,0,0,8" />
                                            <ItemsControl ItemsSource="{Binding Tools}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Width="220" Margin="0,0,10,10" Padding="10,8" HorizontalContentAlignment="Left" Background="{DynamicResource PanelBg}"
                                                                BorderBrush="{DynamicResource ChromeBorder}" Cursor="Hand" Click="HomeTool_Click" Tag="{Binding}">
                                                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ToolRow}" />
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Recent projects" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,8" />
                            <ItemsControl x:Name="HomeRecent">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="0,2">
                                            <Hyperlink Click="RecentProject_Click" Tag="{Binding}">
                                                <Run Text="{Binding Mode=OneWay}" />
                                            </Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Tips" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,8" />
                            <TextBlock Foreground="{DynamicResource TextSecondary}" LineHeight="22" TextWrapping="Wrap">
                                • Double-click a tool in the sidebar to open its tab. Every Enter/Run creates a record in the History panel on the right.<LineBreak />
                                • Group tools into named collections: drag a tool onto a collection, or right-click → Move to.<LineBreak />
                                • In the argument box, ↑/↓ browse previously used arguments. Drop files from the Files panel to insert their paths (converted to /mnt/... for WSL tools).<LineBreak />
                                • Terminal: selecting text copies it, right-click pastes, Ctrl+C with no selection sends an interrupt to the tool.<LineBreak />
                                • Files: enable “Follow terminal folder” to keep the panel and the tab's working directory in sync. Drop files from Windows Explorer to copy them in.<LineBreak />
                                • Shortcuts: Ctrl+N new tool · Ctrl+Shift+N new collection · Ctrl+O open project · Ctrl+B toggle sidebar · Ctrl+W close tab · Ctrl+Tab switch tab · Ctrl+F find in terminal.
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
